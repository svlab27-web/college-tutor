{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Урок «Мой колледж»",
  "description": "Один файл = одна миссия. Поля expected/tests/solution — только для сервера, в браузер не отдаются.",
  "type": "object",
  "required": ["subject", "slug", "title", "skill", "minutes", "story", "steps", "status"],
  "properties": {
    "subject": { "enum": ["python", "math"] },
    "slug": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
    "title": { "type": "string" },
    "skill": { "type": "string", "description": "Микронавык, который тренирует урок" },
    "minutes": { "type": "integer", "minimum": 1 },
    "language": { "enum": ["ru", "kk"], "default": "ru" },
    "story": { "type": "string", "description": "Жизненная ситуация миссии" },
    "status": { "enum": ["draft", "review", "approved"], "description": "approved ставит преподаватель" },
    "approved_by": { "type": "string" },
    "material": { "type": "string", "description": "Утверждённый фрагмент теории — AI опирается только на него" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "prompt", "answer_type", "hints"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "prompt": { "type": "string" },
          "independent": { "type": "boolean", "default": false, "description": "Самостоятельная задача: подсказки отключены" },
          "answer_type": { "enum": ["choice", "number", "formula", "text", "code"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "expected": { "description": "choice: индекс; number: {value, tolerance}; formula/text: эталон" },
          "starter_code": { "type": "string" },
          "tests": {
            "type": "array",
            "description": "code: скрытые тесты, запускаются на сервере",
            "items": { "type": "object", "required": ["call", "expect"], "properties": { "call": { "type": "string" }, "expect": {} } }
          },
          "solution": { "type": "string", "description": "Эталонное решение по шагам — для AI и преподавателя" },
          "hints": {
            "type": "array",
            "maxItems": 3,
            "description": "Лестница: 1 намёк, 2 наводящий вопрос, 3 похожий пример",
            "items": { "type": "string" }
          },
          "common_mistakes": {
            "type": "array",
            "items": { "type": "object", "required": ["pattern", "feedback"], "properties": { "pattern": { "type": "string" }, "feedback": { "type": "string" } } }
          },
          "variants": { "type": "array", "description": "Другие варианты самостоятельной задачи (против списывания)" }
        }
      }
    }
  }
}
