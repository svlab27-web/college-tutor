{
  "name": "college-tutor",
  "private": true,
  "description": "AI-тьютор «Мой колледж»: сервер api/ (Vercel Functions и свой Node-сервер)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "tsc",
    "start": "node dist/server/index.js",
    "test": "tsc && node --test \"dist/tests/**/*.test.js\"",
    "lessons:check": "tsc && node dist/scripts/sync-lessons.js --check",
    "lessons:sync": "tsc && node dist/scripts/sync-lessons.js",
    "lessons:sql": "tsc && node dist/scripts/lessons-sql.js",
    "staff:sql": "tsc && node dist/scripts/staff-sql.js"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
