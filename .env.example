# Скопировать в .env.local и заполнить. Реальные значения — только в Vercel Environment Variables
# (на своём сервере — в .env, chmod 600, docs/production.md).
DATABASE_URL=                # Supabase → Connect → Transaction pooler (порт 6543); свой сервер: postgres://…@db:5432/tutor?sslmode=disable
DB_POOL_MAX=                 # необязательно, по умолчанию 5
BOT_TOKEN=                   # токен Telegram-бота от @BotFather
TG_WEBHOOK_SECRET=           # секрет для заголовка x-telegram-bot-api-secret-token
AI_PROVIDER=                 # deepseek (docs/decisions.md)
AI_API_KEY=                  # ключ DeepSeek
AI_MODEL=                    # deepseek-flash
APP_URL=                     # адрес Mini App на Vercel (кнопка бота)
BOT_USERNAME=                # имя бота без @, по умолчанию tutornvl_bot
# api/ в Supabase-ключах больше не нуждается (решение #33: DATABASE_URL без supabase-js).
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY в Vercel пока не удаляем — могут понадобиться скриптам.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
